// setradar.ai — bass house DJ set database (MVP)
// SQLite for local dev. Note: Prisma enums are not supported on SQLite,
// so status/provenance/type fields are strings with documented allowed values.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A DJ / artist that performs sets.
model Dj {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  realName   String?
  homeCity   String?
  bio        String?
  // Optional preferred style when set genres are mixed / empty.
  genre      String?
  accent     String // hex color used as the profile accent in the UI

  // main social accounts (nullable; crawler can fill real handles later)
  soundcloud String?
  youtube    String?
  instagram  String?
  twitter    String?
  website    String?
  // Canonical Beatport /artist/{slug}/{id} only — never a search page.
  beatport   String?

  // resolved artwork URL (Deezer CDN etc.); null → monogram fallback in UI
  imageUrl   String?

  sets       SetArtist[]
  series     Series[]

  createdAt  DateTime @default(now())
}

// A recurring show / mix series (e.g. a weekly radio show).
// djId is optional — brand-hosted series (Night Owl, Metronome) are not Dj-owned.
model Series {
  id     String @id @default(cuid())
  slug   String @unique
  name   String
  djId   String?
  dj     Dj?    @relation(fields: [djId], references: [id])
  sets   Set[]

  @@index([djId])
}

// A record label.
model Label {
  id         String  @id @default(cuid())
  slug       String  @unique
  name       String
  color      String? // hex, optional brand color
  soundcloud String?
  instagram  String?
  website    String?
  // resolved artwork URL (album art used as label mark); null → initials fallback
  imageUrl   String?
  tracks     Track[]
}

// An event where a set was performed (festival, club night, radio station).
model Event {
  id         String  @id @default(cuid())
  slug       String  @unique
  name       String
  kind       String // "festival" | "club" | "radio" | "livestream"
  location   String?
  // Official site + socials when known (curated / website scan — never invented).
  website    String?
  soundcloud String?
  instagram  String?
  twitter    String?
  imageUrl   String?
  sets       Set[]
  editions   EventEdition[]
  nights     VenueNight[]
}

// A dated edition of a festival brand (Tomorrowland Belgium 2026, EDC LV 2025).
model EventEdition {
  id        String    @id @default(cuid())
  slug      String    @unique
  eventId   String
  event     Event     @relation(fields: [eventId], references: [id])
  year      Int
  label     String? // Belgium | Winter | Miami | Las Vegas | …
  startsAt  DateTime?
  endsAt    DateTime?
  sets      Set[]

  @@index([eventId, year])
  @@index([endsAt])
}

// A dated club night scraped from an official venue calendar (never invented).
model VenueNight {
  id          String    @id @default(cuid())
  slug        String    @unique
  eventId     String
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title       String
  startsAt    DateTime
  endsAt      DateTime?
  sourceUrl   String
  ticketsUrl  String?
  roomsJson   String? // JSON [{ name, artists[] }]
  artistsJson String? // JSON string[]
  sourceHash  String?
  fetchedAt   DateTime  @default(now())

  @@unique([eventId, startsAt, title])
  @@index([startsAt])
  @@index([eventId])
}

// A released, identified track (the playable unit in a set — not the release).
model Track {
  id          String   @id @default(cuid())
  // Public URL slug (artist-title); unique. Backfilled on ingest/thumbs/build.
  slug        String   @unique
  title       String
  artistName  String
  // Mix / version label when distinct from title, e.g. "Extended Mix"
  mixName     String?
  // Remixer credit when present, e.g. "Marten Horger"
  remixerName String?
  labelId     String?
  label       Label?   @relation(fields: [labelId], references: [id])
  // Track-level genre when known (sets also carry a genre)
  genre       String?
  bpm         Int?
  musicalKey  String?
  durationSec Int?
  releaseDate DateTime?
  // resolved release artwork URL; null → no track thumb in UI
  imageUrl    String?
  // Canonical Beatport track/release URL when known (not a search page)
  beatportUrl String?
  // Canonical open.spotify.com/track/{22} when known (not a search page)
  spotifyUrl  String?
  // ISRC when known (ACR / Deezer / MusicBrainz). Join key for store pages.
  isrc        String?

  plays       Played[] @relation("TrackPlays")
  // ID records that were community-resolved to this track.
  resolvedIds IdTrack[] @relation("ResolvedTrack")

  createdAt   DateTime @default(now())

  @@index([labelId])
  @@index([title, artistName])
  @@index([genre])
  @@index([isrc])
}

// A first-class "ID" record for an unreleased / unknown track.
// Resolvable later: when the community identifies it, resolvedTrack is set
// and status flips to "community_resolved".
model IdTrack {
  id             String  @id @default(cuid())
  label          String  // display label, e.g. "ID - ID" or "Marten Horger - ID"
  suspectedArtist String?
  note           String?
  // "unresolved" | "community_resolved"
  status         String  @default("unresolved")
  resolvedTrackId String?
  resolvedTrack  Track?  @relation("ResolvedTrack", fields: [resolvedTrackId], references: [id])

  plays          Played[] @relation("IdPlays")

  createdAt      DateTime @default(now())
}

// A DJ set / mix.
model Set {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  // "festival" | "club" | "livestream" | "radio" | "soundcloud" | "mix"
  type        String
  // music genre, e.g. "Bass House", "Tech House", "UK Garage"
  genre       String?
  publishedAt DateTime
  durationSec Int
  sourceUrl   String?
  sourceName  String? // e.g. "1001Tracklists", "SoundCloud"
  // Original audio host URL used for on-site embed (SC track, hearthis embed, YT).
  // May differ from sourceUrl when discovery host ≠ audio host.
  // Rank stays SoundCloud > Mixcloud > YouTube — one embed, even when
  // extra official hosts are stored below.
  playbackUrl String?
  // Extra official hosts for the same performance (fill-null). Not embeds.
  // Never invent; Mixcloud is a stored mirror only (no Mixcloud set slug).
  soundcloudUrl String?
  youtubeUrl    String?
  mixcloudUrl   String?
  cover       String // hex color for the cover gradient seed
  // resolved set/mix artwork (or primary DJ image); null → monogram fallback
  imageUrl    String?
  // Hash of source payload (description/comments/title). When it changes, ingest
  // refreshes the tracklist instead of skip-forever.
  sourceHash  String?

  eventId     String?
  event       Event?   @relation(fields: [eventId], references: [id])
  editionId   String?
  edition     EventEdition? @relation(fields: [editionId], references: [id])
  /** Best-effort performance / edition date (not upload time). */
  performedAt DateTime?
  seriesId    String?
  series      Series?  @relation(fields: [seriesId], references: [id])

  artists     SetArtist[]
  plays       Played[]

  createdAt   DateTime @default(now())

  @@index([publishedAt])
  @@index([genre])
  @@index([type])
  @@index([eventId])
  @@index([editionId])
  @@index([seriesId])
}

// Join between Set and DJ. Supports b2b / collaborations. One artist is primary.
model SetArtist {
  id        String  @id @default(cuid())
  setId     String
  set       Set     @relation(fields: [setId], references: [id])
  djId      String
  dj        Dj      @relation(fields: [djId], references: [id])
  isPrimary Boolean @default(false)

  @@unique([setId, djId])
  @@index([djId])
}

// The core edge: a track played at a position in a set.
model Played {
  id         String   @id @default(cuid())
  setId      String
  set        Set      @relation(fields: [setId], references: [id])
  position   Int
  // offset from set start, in seconds
  timestamp  Int
  // "identified" | "unresolved_id" | "community_resolved" | "unparsed"
  idStatus   String
  // "1001tl" | "soundcloud" | "fingerprint" | "community"
  provenance String
  // raw parsed text as it appeared in the source tracklist
  rawText    String?

  trackId    String?
  track      Track?   @relation("TrackPlays", fields: [trackId], references: [id])
  idTrackId  String?
  idTrack    IdTrack? @relation("IdPlays", fields: [idTrackId], references: [id])

  @@unique([setId, position])
  @@index([trackId])
  @@index([idTrackId])
  @@index([setId, idStatus])
}
