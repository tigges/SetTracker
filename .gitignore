# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/public/search-index.json

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# opt-in: local sqlite connection string only, no secrets
!.env

# prisma local sqlite database
/prisma/dev.db
/prisma/dev.db-journal
/prisma/*.db
/prisma/*.db-journal
# Enriched catalog shipped via catalog-db-import.yml when GHA ACRCloud secrets fail.
!/prisma/catalog-snapshot.db

# generated ingest scan output
/data/url-scan-candidates.json
/data/venue-candidates.json
# local / CI density audit (artifact only; committed snapshot is set-density-live.json)
/data/crosscheck/set-density.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.next-export/
/out/
.next-pages
